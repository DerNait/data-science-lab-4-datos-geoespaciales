# No coloque usuario, contraseña ni tokens en este archivo.
OPENEO_BACKEND_URL=https://openeofed.dataspace.copernicus.eu
OPENEO_COLLECTION_ID=SENTINEL2_L2A

# Ejercicio 3: credenciales OAuth client de Sentinel Hub /
# Copernicus Data Space para pedir el resultado numérico del script de
# cianobacteria vía la Process API. Se generan en el Dashboard de
# Copernicus Data Space > User Settings > OAuth clients. Son distintas de
# la sesión OIDC personal que usa openEO y NUNCA deben llevar valores reales
# en este archivo ni en commits.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

